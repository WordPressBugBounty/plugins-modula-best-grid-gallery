    "entrances": {
        "rise": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "opacity": 0,
                        "transform": "translateY(40px) scale(.96)"
                    },
                    {
                        "opacity": 1,
                        "transform": "none"
                    }
                ],
                "durationMs": {
                    "base": 800
                },
                "delayMs": {
                    "index": 80
                }
            }
        ],
        "develop": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "clipPath": "inset(100% 0 0 0)"
                    },
                    {
                        "clipPath": "inset(0 0 0 0)"
                    }
                ],
                "durationMs": {
                    "base": 1000
                },
                "delayMs": {
                    "col": 140,
                    "row": 240
                },
                "easing": "cubic-bezier(.7,0,.2,1)"
            },
            {
                "target": "image",
                "keyframes": [
                    {
                        "transform": "scale(1.3)"
                    },
                    {
                        "transform": "none"
                    }
                ],
                "durationMs": {
                    "base": 1500
                },
                "delayMs": {
                    "col": 140,
                    "row": 240
                }
            }
        ],
        "sweep": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "transform": "translateX(-90px)",
                        "opacity": 0,
                        "clipPath": "inset(0 100% 0 0)"
                    },
                    {
                        "transform": "none",
                        "opacity": 1,
                        "clipPath": "inset(0 0 0 0)"
                    }
                ],
                "alternate": {
                    "by": "row",
                    "keyframes": [
                        {
                            "transform": "translateX(90px)",
                            "opacity": 0,
                            "clipPath": "inset(0 0 0 100%)"
                        },
                        {
                            "transform": "none",
                            "opacity": 1,
                            "clipPath": "inset(0 0 0 0)"
                        }
                    ]
                },
                "durationMs": {
                    "base": 1100
                },
                "delayMs": {
                    "row": 180,
                    "col": 50
                },
                "easing": "cubic-bezier(.65,0,.2,1)"
            },
            {
                "target": "image",
                "keyframes": [
                    {
                        "transform": "scale(1.25)"
                    },
                    {
                        "transform": "none"
                    }
                ],
                "durationMs": {
                    "base": 1500
                },
                "delayMs": {
                    "row": 180,
                    "col": 50
                }
            }
        ],
        "darkroom": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "filter": "brightness(0) blur(14px)",
                        "transform": "scale(1.06)"
                    },
                    {
                        "filter": "brightness(1) blur(0)",
                        "transform": "none"
                    }
                ],
                "durationMs": {
                    "base": 1300
                },
                "delayMs": {
                    "index": 150
                },
                "easing": "cubic-bezier(.4,0,.2,1)"
            }
        ],
        "flip": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "transform": "perspective(900px) rotateY(-90deg)",
                        "opacity": 0
                    },
                    {
                        "opacity": 1,
                        "offset": 0.35
                    },
                    {
                        "transform": "perspective(900px) rotateY(0)",
                        "opacity": 1
                    }
                ],
                "durationMs": {
                    "base": 900
                },
                "delayMs": {
                    "row": 110,
                    "col": 110
                },
                "easing": "cubic-bezier(.3,1.3,.5,1)"
            }
        ],
        "drop": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "transform": "translateY(-760px) rotate(-26deg)"
                    },
                    {
                        "transform": "none"
                    }
                ],
                "alternate": {
                    "by": "index",
                    "keyframes": [
                        {
                            "transform": "translateY(-760px) rotate(26deg)"
                        },
                        {
                            "transform": "none"
                        }
                    ]
                },
                "durationMs": {
                    "base": 950
                },
                "delayMs": {
                    "index": 100
                },
                "easing": "cubic-bezier(.34,1.45,.55,1)"
            },
            {
                "target": "image",
                "keyframes": [
                    {
                        "filter": "sepia(1) brightness(2.3) contrast(.3) saturate(0) blur(3px)"
                    },
                    {
                        "filter": "sepia(.6) brightness(1.4) contrast(.7) saturate(.4) blur(1px)",
                        "offset": 0.45
                    },
                    {
                        "filter": "none"
                    }
                ],
                "durationMs": {
                    "base": 2400
                },
                "delayMs": {
                    "base": 700,
                    "index": 100
                },
                "easing": "ease-out"
            }
        ],
        "deal": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "transform": "translate({dx}px, {dy}px) rotate({scatter}deg) scale({fit})",
                        "zIndex": "{stack}"
                    },
                    {
                        "transform": "translate({dx}px, {dy}px) rotate({scatter}deg) scale({fit})",
                        "zIndex": "{stack}",
                        "offset": 0.3
                    },
                    {
                        "transform": "none",
                        "zIndex": "1"
                    }
                ],
                "durationMs": {
                    "base": 1500,
                    "index": 50
                },
                "delayMs": {
                    "index": 40
                },
                "easing": "cubic-bezier(.3,1.25,.4,1)"
            }
        ],
        "aperture": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "clipPath": "circle(0% at 50% 50%)"
                    },
                    {
                        "clipPath": "circle(75% at 50% 50%)"
                    }
                ],
                "durationMs": {
                    "base": 1000
                },
                "delayMs": {
                    "distance": 0.9
                },
                "easing": "cubic-bezier(.6,0,.2,1)"
            },
            {
                "target": "image",
                "keyframes": [
                    {
                        "transform": "scale(1.35) rotate(-4deg)"
                    },
                    {
                        "transform": "none"
                    }
                ],
                "durationMs": {
                    "base": 1400
                },
                "delayMs": {
                    "distance": 0.9
                }
            }
        ],
        "curtain": [
            {
                "target": "tile",
                "keyframes": [
                    {
                        "clipPath": "inset(0 100% 0 0)"
                    },
                    {
                        "clipPath": "inset(0 0 0 0)"
